<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for Android 12 and higher. Device-to-device transfer keeps everything.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Progress photos are private and large enough to push a backup past its size limit. -->
        <exclude domain="file" path="progress_photos/" />
    </cloud-backup>
</data-extraction-rules>
